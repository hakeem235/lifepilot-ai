# Django
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (local dev — discrete vars; managed hosts inject DATABASE_URL instead)
DB_NAME=lifepilot
DB_USER=lifepilot
DB_PASSWORD=lifepilot
DB_HOST=localhost
DB_PORT=5432
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# CORS / CSRF (Expo dev server + simulator; production: the app's API origin)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
CSRF_TRUSTED_ORIGINS=

# Auth — Clerk (wired in Issue 8.1; server-side JWT verification via JWKS)
CLERK_JWKS_URL=
CLERK_ISSUER=

# AI — Anthropic Claude (wired in Issue 8.3; server-side proxy only, never client-side)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CHAT=claude-opus-4-8
ANTHROPIC_MODEL_SUMMARY=claude-haiku-4-5-20251001
# Day-plan reasoning (Issue 10.0) / daily review (10.2) — D13 model split.
ANTHROPIC_MODEL_PLAN=claude-opus-4-8

# Google Calendar (read-only overlay, Issue 9.3; server-side OAuth — never client-side)
# Create an OAuth 2.0 Client (Web application) in Google Cloud Console, enable the
# Google Calendar API, and add the redirect URI below. Scope: calendar.readonly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/gcal/callback/
