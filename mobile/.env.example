# Public config for the Expo app (EXPO_PUBLIC_* is bundled into the client —
# NEVER put secrets here; the Anthropic key stays server-side, Issue 8.3).

# Base URL of the LifePilot backend API.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Clerk publishable key (client-safe) — wired in Issue 8.1.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
